PORT=4000
# Shared development database (recommended):
# mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/boarding_house?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017/boarding_house
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/boarding_house?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-shared-development-secret-of-at-least-32-characters
NODE_ENV=development
SEED_LANDLORD_EMAIL=landlord@example.com
SEED_LANDLORD_PASSWORD=
