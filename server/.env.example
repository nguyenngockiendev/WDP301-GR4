PORT=4000
# Use the shared team database and current credentials/cluster host from Atlas.
# URL-encode special characters in the database password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/WDP301_GR4?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-shared-development-secret-of-at-least-32-characters
NODE_ENV=development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Smart Rental <no-reply@example.com>
SEED_LANDLORD_EMAIL=landlord@example.com
SEED_LANDLORD_PASSWORD=
