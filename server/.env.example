PORT=4000
# Shared Atlas database used by the original group project. Replace the placeholders
# with the current rotated database credentials and cluster host from MongoDB Atlas.
# mongodb+srv://<db_username>:<db_password>@<cluster-host>/WDP301_GR4?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017/boarding_house
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/WDP301_GR4?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-shared-development-secret-of-at-least-32-characters
NODE_ENV=development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Smart Rental <no-reply@example.com>
SEED_LANDLORD_EMAIL=landlord@example.com
SEED_LANDLORD_PASSWORD=
